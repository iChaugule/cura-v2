{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd expo-app && npm install",
  "buildCommand": "cd expo-app && npx expo export --platform web --output-dir dist",
  "outputDirectory": "expo-app/dist",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
